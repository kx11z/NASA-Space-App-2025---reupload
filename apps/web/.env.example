# Optional public API origin. Never put an API key in a NEXT_PUBLIC variable.
# With no backend configured, both local development and GitHub Pages use educational mode.
# NEXT_PUBLIC_API_BASE_URL=https://your-api.example.com
# NEXT_PUBLIC_BASE_PATH=/NASA-Space-App-2025---reupload
# For a frontend hosted alongside the optional Cloudflare Functions:
# NEXT_PUBLIC_SAME_ORIGIN_API=true
